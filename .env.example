# Copy this file to .env.<name> (for example .env.staging) and fill in the values.
# The file is picked with the ENV variable. ENV=staging reads .env.staging. Default is demo.
# Real environment variables always win over values in the file.
BASE_URL=
ADMIN_USER=
ADMIN_PASS=

# Optional
# ESS_ROLE_ID=2
# LOG_LEVEL=info
